# Production Environment Variables for Readstr
# Copy this file to .env.production and fill in the values

# Database Configuration
DATABASE_URL="postgresql://nostr_user:nostr_password@postgres:5432/readstr"

# Application Environment
NODE_ENV="production"

# Nostr Configuration
# DEFAULT_RELAYS: comma-separated list of wss:// relay URLs. This value is public:
# it is sent to browsers and appears in generated RSS feeds. Never put credentials in it.
DEFAULT_RELAYS="wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band,wss://relay.snort.social"
NOSTR_BUNKER_URL=""

# Optional: overrides the admin npub. Defaults to the bundled admin npub when unset.
NEXT_PUBLIC_ADMIN_NPUB=""

# PayWithFlash Configuration
FLASH_CHECKOUT_URL=""  # Plan signup URL from the Flash dashboard (public; read at runtime)
FLASH_WEBHOOK_SECRET=""  # Webhook endpoint signing secret (whsec_...). SECRET: server env only, never commit

# Security
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32

# Optional: Analytics and Monitoring
NEXT_PUBLIC_ANALYTICS_ID=""

# Optional: Error Tracking
SENTRY_DSN=""

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1