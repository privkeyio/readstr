pkgname=readstr
# Bump together with VERSION in src/sources.pri.
pkgver=0.1.0
pkgrel=1
pkgdesc='Read RSS, Nostr, and video subscriptions in an Omarchy window'
arch=('x86_64' 'aarch64')
url='https://github.com/privkeyio/readstr'
license=('MIT')
# qt6-base also provides QtNetwork, QtSql with its SQLite driver, and QtDBus,
# which reaches xdg-desktop-portal for the OPML open and save dialogs.
# qt6-websockets talks to Nostr relays and libsecp256k1 checks the signatures
# on their events. mpv plays Nostr videos; Omarchy ships it.
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'qt6-websockets' 'libsecp256k1'
         'xdg-desktop-portal' 'mpv')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

# Builds from the local checkout for now; the omarchy-pkgs PKGBUILD will build
# from the desktop-v<version> release tarball with `cd desktop`. The build runs
# in a fresh directory under $srcdir, so objects from bin/build are never
# reused, and qmake gets makepkg's hardening flags, which it ignores otherwise.
# Qt's rpath feature would add a RUNPATH of /usr/lib, which the loader searches
# anyway, so it is blanked.
build() {
  rm -rf "$srcdir/build"
  mkdir -p "$srcdir/build"
  cd "$srcdir/build"
  qmake6 "$startdir/../readstr.pro" \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS" \
    QMAKE_LFLAGS_RPATH=
  make
}

package() {
  install -Dm755 "$srcdir/build/readstr" "$pkgdir/usr/bin/readstr"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/readstr.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/readstr.svg"
  install -Dm644 "$startdir/readstr.desktop" "$pkgdir/usr/share/applications/readstr.desktop"
}
