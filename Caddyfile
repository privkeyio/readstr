{
    email kyle@privkey.io

    # Cut off clients that trickle headers or bodies instead of letting them
    # hold a connection open; the app's own request limits are 15 s and 30 s.
    # write runs from the end of the request headers through the whole
    # response, handler time included, so it sits well above the slowest
    # handler (a full feed refresh) and only bounds clients that stop reading.
    servers {
        timeouts {
            read_header 10s
            read_body 30s
            write 5m
            idle 2m
        }
    }
}

readstr.privkey.io {
    # Refuse oversized API bodies at the edge as well; the app caps tRPC and
    # webhook bodies at 64 KB itself.
    request_body /api/* {
        max_size 64KB
    }

    # Reverse proxy to the Next.js app
    reverse_proxy app:3000 {
        # Overwrite X-Forwarded-For at the trust boundary so clients cannot
        # inject spoofed entries; the app reads the rightmost (real peer) hop.
        header_up X-Forwarded-For {remote_host}

        # Health check
        health_uri /api/health
        health_interval 30s
        health_timeout 5s
    }

    # Enable compression
    encode gzip

    # Security headers (CSP/HSTS/nosniff/Referrer-Policy) are emitted by the app
    # in next.config.mjs as the single authoritative source — do not duplicate
    # them here, as browsers intersect multiple CSPs.
    header {
        # Remove server information
        -Server
    }

    # Log to stdout
    log {
        output stdout
        format console
    }
}
